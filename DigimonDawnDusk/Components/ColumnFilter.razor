@typeparam T where T : notnull

<div class="bg-dark p-3">
	<div class="form-check">
		<input class="form-check-input"
			   type="checkbox"
			   id="@MyId"
			   checked="checked"
			   @onchange="SetAll" />
		<label class="form-check-label" for="@MyId">All</label>
	</div>

	@foreach (var item in Value)
	{

		@if (item.Key is IDescriptor descriptor)
		{
			var tId = $"{MyId}_{descriptor.Name}";
			<div class="form-check">
				<input class="form-check-input"
					   type="checkbox"
					   id="@tId"
					   checked="@item.Value"
					   @onchange="(e) => OnChanged(item.Key, e)" />
				<label class="form-check-label" data-bs-toggle="tooltip" title="@descriptor.Descriptor" for="@tId">@descriptor.Name</label>
			</div>
		}
		else
		{
			var tId = $"{MyId}_{item.Key}";
			<div class="form-check">
				<input class="form-check-input"
					   type="checkbox"
					   id="@tId"
					   checked="@item.Value"
					   @onchange="(e) => OnChanged(item.Key, e)" />
				<label class="form-check-label" for="@tId">@item.Key</label>
			</div>
		}
	}
</div>

@code {
	private string MyId { get; set; } = Guid.NewGuid().ToString();
	[Parameter] public required string Placeholder { get; set; }

	[Parameter] public required MultiSelectItems<T> Value { get; set; }
	[Parameter] public EventCallback<MultiSelectItems<T>> ValueChanged { get; set; }

	private async Task SetAll(ChangeEventArgs e)
	{
		var val = (bool)e.Value!;
		foreach (var value in Value)
		{
			Value[value.Key] = val;
		}
		await ValueChanged.InvokeAsync(Value);
		await InvokeAsync(StateHasChanged);
	}

	private async Task OnChanged(T item, ChangeEventArgs e)
	{
		Value[item] = (bool)e.Value!;
		await ValueChanged.InvokeAsync(Value);
	}
}