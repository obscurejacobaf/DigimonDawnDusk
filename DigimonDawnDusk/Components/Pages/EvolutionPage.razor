@page "/Evolution"

<div class="row mt-2">
	<div class="col-3">
		<InputSelect @bind-Value="TargetDigimonId" class="form-select">
			@foreach(var mon in AllDigimon)
			{
				<option value="@mon.DigimonId">@mon.Name</option>
			}
		</InputSelect>
	</div>
</div>
<div class="row mt-2">
	<div class="col-3">
		<InputSelect @bind-Value="MoveOneId" class="form-select">
			@foreach (var move in AllMoves)
			{
				<option value="@move.Key">@move.Value.Name</option>
			}
		</InputSelect>
	</div>
</div>
<div class="row mt-2">
	<div class="col-3">
		<InputSelect @bind-Value="MoveTwoId" class="form-select">
			@foreach (var move in AllMoves)
			{
				<option value="@move.Key">@move.Value.Name</option>
			}
		</InputSelect>
	</div>
</div>
<div class="row mt-2">
	<div class="col-3">
		<InputSelect @bind-Value="MoveThreeId" class="form-select">
			@foreach (var move in AllMoves)
			{
				<option value="@move.Key">@move.Value.Name</option>
			}
		</InputSelect>
	</div>
</div>
<div class="row mt-2">
	<div class="col-3">
		<InputSelect @bind-Value="MoveFourId" class="form-select">
			@foreach (var move in AllMoves)
			{
				<option value="@move.Key">@move.Value.Name</option>
			}
		</InputSelect>
	</div>
</div>
<div class="row mt-2">
	<div class="col-3">
		<button class="btn btn-primary" @onclick="() => CalculateEvolution()">Get Evolution Path</button>
	</div>
</div>
<div class="row mt-2">
	<div class="col">
		@if (ShortestPaths.Count == 0)
		{
			<div>InvalidPath</div>
		}
		else
		{
			@foreach (var path in ShortestPaths)
			{
				<div>
					@if (path.MovesGained.Count > 0)
					{
						<span>@(string.Join(", ", path.MovesGained)):&nbsp;</span>
					}
					@{
						int i = 0;
					}
					@foreach (var node in path.Nodes)
					{
						if (node.Evolution == null)
						{
							<span>@node.Name</span>
						}
						else
						{
							<span title="@node.Descriptor">@node.Name</span>
						}

						i++;
						if (i < path.Nodes.Count)
						{
							<span> —> </span>
						}
					}
				</div>
			}
		}
	</div>
</div>

@code {
	[Inject]
	public required IDbContextFactory<DigimonDbContext> Factory { get; init; }

	private int TargetDigimonId = default!;
	private int MoveOneId = default!;
	private int MoveTwoId = default!;
	private int MoveThreeId = default!;
	private int MoveFourId = default!;

	private List<Digimon> AllDigimon = default!;
	private Dictionary<int, Move> AllMoves = default!;
	private List<EvolutionPath> ShortestPaths = [];

	protected override async Task OnInitializedAsync()
	{
		using var context = await Factory.CreateDbContextAsync();
		AllDigimon = await context.Digimon
			.OrderBy(x => x.Name)
			.ToListAsync();

		AllMoves = await context.Moves
			.Include(x => x.Digimon)
				.ThenInclude(x => x.FromEvolutions)
					.ThenInclude(x => x.To)
			.Include(x => x.Digimon)
				.ThenInclude(x => x.ToEvolutions)
					.ThenInclude(x => x.From)
			.Where(x => x.LevelGained != 0)
			.OrderBy(x => x.Name)
			.ToDictionaryAsync(x => x.MoveId);

		TargetDigimonId = AllDigimon.First().DigimonId;
		MoveOneId = AllMoves.First().Key;
		MoveTwoId = MoveOneId;
		MoveThreeId = MoveOneId;
		MoveFourId = MoveOneId;
	}

	private void CalculateEvolution()
	{
		ShortestPaths.Clear();

		var target = AllDigimon.First(x => x.DigimonId == TargetDigimonId);

		var goalMoves = new HashSet<Move>
		{
			AllMoves[MoveOneId],
			AllMoves[MoveTwoId],
			AllMoves[MoveThreeId],
			AllMoves[MoveFourId]
		};

		// No need to look for moves if our target mon learns them normally.
		var targetMoves = goalMoves.Where(x => target.Moves.Contains(x)).ToList();
		if (targetMoves.Count() > 0)
		{
			ShortestPaths.Add(new() { Nodes = [new(target)], MovesGained = targetMoves.ToList() });
			goalMoves.RemoveWhere(x => target.Moves.Contains(x));
		}

		// Group the mons by number of goal moves they have, then get the max number of moves
		var monLookup = AllDigimon.ToLookup(x => x.Moves.Count(m => goalMoves.Contains(m)))
			.MaxBy(x => x.Key);
		if (monLookup == null)
			return;

		// Our starting nodes are the mons with the most moves.
		var startMons = monLookup.ToHashSet();
		var trackStart = true;

		while (goalMoves.Count != 0)
		{
			var result = FindPathToMove(startMons, goalMoves);

			if (result == null)
				return;

			if (trackStart)
			{
				trackStart = false;
				var startMoves = result.Nodes.First().Digimon.Moves.Where(x => goalMoves.Contains(x)).ToHashSet();
				ShortestPaths.Add(new()
				{
					Nodes = [result.Nodes.First()],
					MovesGained = startMoves.ToList(),
				});
				goalMoves.RemoveWhere(x => startMoves.Contains(x));
			}

			ShortestPaths.Add(result);
			goalMoves.RemoveWhere(x => result.Nodes.Last().Digimon.Moves.Contains(x));

			startMons = new() { result.Nodes.Last().Digimon };
		}

		var finalPath = FindPathToTarget([ShortestPaths.Last().Nodes.Last().Digimon], target);
		if (finalPath != null)
			ShortestPaths.Add(finalPath);
	}

	private EvolutionPath? FindPathToMove(HashSet<Digimon> startNodes, HashSet<Move> targetMoves)
	{
		var queue = new Queue<(List<EvolutionNode> path, HashSet<Digimon> visited, HashSet<Move> ownedMoves)>();

		foreach (var start in startNodes)
		{
			var owned = start.Moves
				.Where(targetMoves.Contains)
				.ToHashSet();

			queue.Enqueue((new List<EvolutionNode> { new(start) }, new HashSet<Digimon>() { start }, owned));
		}

		while (queue.Count > 0)
		{
			var (path, visited, ownedMoves) = queue.Dequeue();
			var current = path[^1];

			var newMoves = current.Digimon.Moves
				.Where(m => targetMoves.Contains(m) && !ownedMoves.Contains(m))
				.ToList();

			if (newMoves.Count > 0)
			{
				return new EvolutionPath
				{
					Nodes = path,
					MovesGained = newMoves
				};
			}

			var nextOwned = new HashSet<Move>(ownedMoves);

			foreach (var m in current.Digimon.Moves)
			{
				if (targetMoves.Contains(m))
					nextOwned.Add(m);
			}

			foreach (var neighbor in GetNeighbors(current.Digimon))
			{
				if (visited.Add(neighbor.Digimon))
				{
					queue.Enqueue((new List<EvolutionNode>(path) { neighbor }, visited, nextOwned));
				}
			}
		}

		return null;
	}

	private EvolutionPath? FindPathToTarget(List<Digimon> startNodes, Digimon target)
	{
		var queue = new Queue<List<EvolutionNode>>();
		var visited = new HashSet<Digimon>();

		foreach (var start in startNodes)
		{
			queue.Enqueue(new List<EvolutionNode> { new(start) });
			visited.Add(start);
		}

		while (queue.Count > 0)
		{
			var path = queue.Dequeue();
			var current = path[^1];

			if (current.Digimon.Equals(target))
			{
				return new EvolutionPath { Nodes = path };
			}

			foreach (var neighbor in GetNeighbors(current.Digimon))
			{
				if (visited.Add(neighbor.Digimon))
				{
					queue.Enqueue(new List<EvolutionNode>(path) { neighbor });
				}
			}
		}

		return null;
	}

	private IEnumerable<EvolutionNode> GetNeighbors(Digimon d)
	{
		foreach (var e in d.ToEvolutions)
			yield return new(e.From, e);

		foreach (var e in d.FromEvolutions)
			yield return new(e.To, e);
	}
}
